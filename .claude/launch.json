{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "diagram",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["serve", "docs"],
      "port": 3333
    },
    {
      "name": "dashboard",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "dashboard", "dev"],
      "port": 3000
    },
    {
      "name": "dashboard-verify",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "dashboard", "exec", "vite", "--port", "5173"],
      "port": 5173,
      "autoPort": false
    }
  ]
}
