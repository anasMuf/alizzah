# Backend (API) Configuration
PORT=8080
# Port koperasi-api (cmd/koperasi) — terpisah dari PORT agar kedua binary bisa
# jalan bersama di satu host saat dev.
KOPERASI_PORT=8081
JWT_SECRET=supersecretkey
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=alizzah_db
DB_PORT=5432
SSL_MODE=disable

# Frontend (Platform) Configuration
VITE_API_URL=http://localhost:8080/api
# Dashboard mengarahkan /koperasi/* ke koperasi-api
VITE_KOPERASI_API_URL=http://localhost:8081/api
# Dashboard mengarahkan /sdm/* ke sdm-api (SDM/HR penggajian)
VITE_SDM_API_URL=http://localhost:8082/api

# ---- SDM/HR (Penggajian): tautan publik slip & kirim WA ----
# Basis URL halaman publik /s/<token> (untuk tautan di pesan WA)
PUBLIC_APP_URL=http://localhost:3000
# Kunci HMAC token tautan publik (openssl rand -hex 32); fallback ke JWT_SECRET bila kosong
PUBLIC_LINK_SECRET=
# Masa berlaku tautan slip (jam) — default 72 (3 hari)
PUBLIC_LINK_TTL_HOURS=72
# Wablas — biarkan kosong di dev agar worker antrian tidak aktif
WABLAS_DOMAIN=
WABLAS_TOKEN=
