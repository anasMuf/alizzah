# =====================================================================
#  Contoh konfigurasi PRODUKSI (VPS multi-app, nginx di HOST).
#  Di VPS: salin menjadi `.env` (file ini di-commit, `.env` TIDAK).
#      cp .env.production.example .env  &&  nano .env
# =====================================================================

# ---- Registry image (GitHub Container Registry) ----
REGISTRY=ghcr.io
IMAGE_OWNER=anasmuf          # username/org GitHub, HARUS huruf kecil
IMAGE_TAG=latest             # diisi otomatis dengan commit SHA oleh CI saat deploy

# ---- Port loopback host (di-proxy nginx host) ----
# Pastikan tidak bentrok dengan app lain di VPS.
API_PORT=8091                # nginx host: proxy_pass http://127.0.0.1:8091  (api.alizzah...)
WEB_PORT=8090                # nginx host: proxy_pass http://127.0.0.1:8090  (dashboard.alizzah...)
KOPERASI_API_PORT=8092       # nginx host: proxy_pass http://127.0.0.1:8092  (koperasi-api.alizzah...)

# ---- Database (Postgres dalam container, internal) ----
DB_USER=alizzah
DB_PASSWORD=ganti_dengan_password_kuat
DB_NAME=alizzah_db

# ---- API ----
JWT_SECRET=ganti_dengan_string_acak_panjang          # openssl rand -hex 32
CORS_ALLOWED_ORIGINS=https://dashboard.alizzah.anaslabs.my.id
# Origin app koperasi (kosongkan → fallback ke CORS_ALLOWED_ORIGINS)
KOPERASI_CORS_ALLOWED_ORIGINS=https://koperasi.alizzah.anaslabs.my.id
# Password awal SEMUA user seeder — WAJIB diisi sebelum deploy pertama
SEED_ADMIN_PASSWORD=ganti_dengan_password_admin_awal

# =====================================================================
#  TLS & domain ditangani nginx HOST + certbot host (bukan di compose).
#  VITE_API_URL & VITE_KOPERASI_API_URL di-bake saat build → set sebagai
#  GitHub Actions *Variable*. Dashboard (satu app) memanggil dua backend:
#      VITE_API_URL          = https://api.alizzah.anaslabs.my.id/api        (school-api)
#      VITE_KOPERASI_API_URL = https://koperasi-api.alizzah.anaslabs.my.id/api (koperasi-api)
#  Alternatif: arahkan keduanya ke satu domain & biarkan nginx host memisah by-path
#  (/api/v1/koperasi/* -> koperasi-api, sisanya -> api).
# =====================================================================
