# =====================================================================
#  Contoh konfigurasi PRODUKSI.
#  Di VPS: salin menjadi `.env` (file ini di-commit, `.env` TIDAK).
#      cp .env.production.example .env  &&  nano .env
# =====================================================================

# ---- Registry image (GitHub Container Registry) ----
REGISTRY=ghcr.io
IMAGE_OWNER=anasmuf          # username/org GitHub, HARUS huruf kecil
IMAGE_TAG=latest             # diisi otomatis dengan commit SHA oleh CI saat deploy

# ---- Domain (tanpa http/https) ----
APP_DOMAIN=app.contoh-sekolah.sch.id
API_DOMAIN=api.contoh-sekolah.sch.id
LETSENCRYPT_EMAIL=admin@contoh-sekolah.sch.id
# LETSENCRYPT_STAGING=1      # set 1 saat uji coba sertifikat (hindari rate limit Let's Encrypt)

# ---- Database (Postgres dalam container) ----
DB_USER=alizzah
DB_PASSWORD=ganti_dengan_password_kuat
DB_NAME=alizzah_db

# ---- API ----
# string acak panjang, mis: openssl rand -hex 32
JWT_SECRET=ganti_dengan_string_acak_panjang
# Origin frontend yang diizinkan (samakan dengan APP_DOMAIN)
CORS_ALLOWED_ORIGINS=https://app.contoh-sekolah.sch.id
# Password awal untuk SEMUA user seeder — WAJIB diisi sebelum deploy pertama
# (kalau kosong, kode fallback ke "password123" — jangan dibiarkan di produksi)
SEED_ADMIN_PASSWORD=ganti_dengan_password_admin_awal

# =====================================================================
#  CATATAN: VITE_API_URL TIDAK di sini.
#  Ia di-"bake" saat build image dashboard, jadi diset sebagai
#  GitHub Actions *Variable* bernama VITE_API_URL, contoh nilai:
#      https://api.contoh-sekolah.sch.id/api
# =====================================================================
